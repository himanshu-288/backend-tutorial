{
  "info": {
    "name": "Backend Tutorial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:4000"
    }
  ],
  "item": [
    {
      "name": "Register demo user",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/api/v1/users/register",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "register"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo{{run}}\",\n  \"email\": \"demo{{run}}@example.com\",\n  \"password\": \"Tutorial-demo-123\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"run\", String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Log in",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/api/v1/users/login",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "login"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo{{run}}@example.com\",\n  \"password\": \"Tutorial-demo-123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create a post",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/api/v1/posts/create",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "posts",
            "create"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"First post\",\n  \"description\": \"Evaluation demo\",\n  \"age\": 21\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"postId\", pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read posts",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/api/v1/posts/getPosts",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "posts",
            "getPosts"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Created post is listed\", () => pm.expect(pm.response.json().map(p => p._id)).to.include(pm.collectionVariables.get(\"postId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid age",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{base}}/api/v1/posts/update/{{postId}}",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "posts",
            "update",
            "{{postId}}"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 151\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update the post",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{base}}/api/v1/posts/update/{{postId}}",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "posts",
            "update",
            "{{postId}}"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated in Postman\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Description changed\", () => pm.expect(pm.response.json().description).to.equal(\"Updated in Postman\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete the post",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base}}/api/v1/posts/delete/{{postId}}",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "posts",
            "delete",
            "{{postId}}"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm deletion",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/api/v1/posts/getPosts",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "posts",
            "getPosts"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Post removed\", () => pm.expect(pm.response.json().map(p => p._id)).not.to.include(pm.collectionVariables.get(\"postId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Log out",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/api/v1/users/logout",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "logout"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject logged-out token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/api/v1/posts/getPosts",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "posts",
            "getPosts"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}